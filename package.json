{
  "name": "ebt",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "description": "EBT — unified multi-chain TESTNET bridge & swap platform",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",

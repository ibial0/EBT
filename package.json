{
  "name": "ebt",
  "private": true,
  "version": "0.64.2",
  "type": "module",
  "description": "EBT \u2014 unified multi-chain TESTNET bridge & swap platform",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test:sim": "esbuild scripts/simulate.ts --bundle --platform=node --format=esm --outfile=scripts/simulate.mjs --external:@x402/* --log-level=warning && node scripts/simulate.mjs",
    "test:routes": "esbuild scripts/routes-check.ts --bundle --platform=node --format=esm --outfile=scripts/routes-check.mjs --log-level=error --external:@x402/* && node scripts/routes-check.mjs",
    "test:deposit": "esbuild scripts/deposit-check.ts --bundle --platform=node --format=esm --outfile=scripts/deposit-check.mjs --log-level=error --external:@x402/* && node scripts/deposit-check.mjs",
    "test:orbit": "esbuild scripts/orbit-check.ts --bundle --platform=node --format=esm --outfile=scripts/orbit-check.mjs --log-level=error --external:@x402/* && node scripts/orbit-check.mjs",
    "test:history": "node --experimental-strip-types scripts/history-check.mjs",
    "test:address": "node --experimental-strip-types scripts/address-check.mjs",
    "test:recovery": "node --experimental-strip-types scripts/recovery-check.mjs",
    "test:picker": "node --experimental-strip-types scripts/picker-chain-check.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@tanstack/react-query": "^5.62.7",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "viem": "^2.51.0",
    "wagmi": "^2.14.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "overrides": {
    "ws": "^8.21.0",
    "uuid": "^11.1.1"
  }
}
